# Porta do servidor
PORT=3000
# Senha para baixar os leads em /api/leads.csv (usuário: qualquer, senha: este valor)
ADMIN_TOKEN=troque-por-uma-senha-forte
# (Opcional) URL que recebe cada lead em JSON — Zapier, Make, n8n, RD Station, Google Sheets via Apps Script...
LEAD_WEBHOOK_URL=
# Use 1 quando estiver atrás de proxy/CDN (Render, Railway, Nginx) para ler o IP real no limitador de envios
TRUST_PROXY=1
# Caminho do arquivo onde os leads são gravados
# LEADS_FILE=./data/leads.jsonl
